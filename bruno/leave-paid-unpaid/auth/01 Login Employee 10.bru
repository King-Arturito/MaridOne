meta {
  name: 01 Login Employee 10
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "username": "{{employeeUsername}}",
    "password": "{{employeePassword}}",
    "rememberMe": false
  }
}
