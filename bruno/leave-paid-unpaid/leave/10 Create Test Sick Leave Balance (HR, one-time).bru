meta {
  name: 10 Create Test Sick Leave Balance (HR, one-time)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/leave/balance/{{employeeId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{hrToken}}
}

headers {
  content-type: application/json
}

body:json {
  {
    "leaveType": "{{leaveType}}",
    "balanceHours": 4.00
  }
}
