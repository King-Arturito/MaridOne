meta {
  name: Run Payroll (Seeded Oct Window)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/test/payroll-run
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "periodStart": "{{seededPayrollStart}}",
    "periodEnd": "{{seededPayrollEnd}}",
    "periodDescription": "Seeded October payroll verification",
    "payrollStatus": "IN_PROGRESS",
    "runType": "REGULAR"
  }
}
